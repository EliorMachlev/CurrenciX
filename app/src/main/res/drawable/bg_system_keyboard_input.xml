<?xml version="1.0" encoding="UTF-8"?>
<!-- Outlined text-field look for the calculations EditText when the "System
     keyboard" pref is active. colorOutline in this theme resolves to
     colorOnBackground (pure fg colour), which reads as a harsh black square;
     textColorSecondary is the softer border tone used elsewhere in the app
     (see dotted_line.xml). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <stroke
        android:width="1dp"
        android:color="?android:attr/textColorSecondary" />
    <corners android:radius="12dp" />
</shape>
