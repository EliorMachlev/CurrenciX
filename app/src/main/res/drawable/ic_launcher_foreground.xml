<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon's mark, in its colors on ink (ic_launcher_background). Paths: values/brand_mark.xml. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="@color/billGreen"
        android:pathData="@string/brand_mark_arrow_top"
        android:strokeColor="@color/billGreen"
        android:strokeLineJoin="round"
        android:strokeWidth="@dimen/brand_mark_arrow_round" />
    <path
        android:fillColor="@color/brass"
        android:pathData="@string/brand_mark_arrow_bottom"
        android:strokeColor="@color/brass"
        android:strokeLineJoin="round"
        android:strokeWidth="@dimen/brand_mark_arrow_round" />
    <path
        android:pathData="@string/brand_mark_cross"
        android:strokeColor="@color/launcherMarkCross"
        android:strokeLineCap="round"
        android:strokeWidth="@dimen/brand_mark_cross_width" />
</vector>
