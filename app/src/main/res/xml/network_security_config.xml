<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is refused globally. Every exchange-rate provider currently
  configured (see ApiProvider) exposes HTTPS-only endpoints, so this closes
  off downgrade/MITM avenues without breaking any real traffic.

  Certificate Transparency: a provider's certificate must be in the public CT
  logs, so a certificate mis-issued for one of its hosts (by any CA the phone
  trusts) is refused. Android 17 checks this by default for apps targeting it;
  Android 16 only when asked, as here; earlier versions can't. The app's
  OkHttp client uses the platform's trust manager, which applies it.

  Certificate pinning: each host the app may reach (HttpClientProvider.
  allowedHosts) is accepted only when its verified chain holds one of the
  keys pinned for it below: the public keys of the certificate authorities
  its chain runs through, its intermediates and their root, never the
  server's own certificate (that changes at every renewal). Each domain-config
  takes everything else from base-config. Android stops checking a pin-set
  after its expiration date, so the pins are renewed in every release (see
  docs/markDown/engineering/security.md#certificate-pinning).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <certificateTransparency enabled="true" />
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
