<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Named subpaths under cacheDir where transient share artifacts live.
         The exported names in the FileProvider URI stay stable across app updates
         even if the on-disk directory layout changes. -->
    <cache-path
        name="cart-exports"
        path="cart-exports/" />
    <cache-path
        name="share-images"
        path="share-images/" />
</paths>
