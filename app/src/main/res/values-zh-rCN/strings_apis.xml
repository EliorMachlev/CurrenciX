<resources>
    <string name="api_bankOfCanada_descriptionFull"><a href="https://www.bankofcanada.ca/rates/exchange/daily-exchange-rates/"><b>加拿大银行</b></a> 的每日平均汇率。\n<b>包括约 23 种货币的汇率。</b></string>
    <string name="api_bankOfCanada_descriptionShort">约 23 种汇率\n来源：加拿大中央银行</string>
    <string name="api_bankOfCanada_descriptionUpdateInterval">汇率于每个工作日美国东部时间 16:30 前发布一次</string>
    <string name="api_bankOfIsrael_descriptionFull">由以色列中央银行<a href="https://www.boi.org.il/en/economic-roles/statistics/foreign-exchange-market/exchange-rates/"><b>以色列银行</b></a>发布的代表性汇率。汇率以以色列新谢克尔为基准。\n<b>以色列银行提供了大约 14 种汇率。</b></string>
    <string name="api_bankOfIsrael_descriptionShort">约 14 种汇率\n来源：以色列中央银行</string>
    <string name="api_bankOfIsrael_descriptionUpdateInterval">代表性汇率在每个工作日约 15:30（以色列时间）发布一次。</string>
    <string name="api_bankRossii_descriptionFull">由俄罗斯中央银行<a href="https://cbr.ru/eng/currency_base/daily/"><b>俄罗斯银行</b></a>提供的汇率。在当前制裁形势下，该来源提供的俄罗斯卢布汇率可能是最可靠的。\n<b>俄罗斯银行提供约 44 种汇率。</b></string>
    <string name="api_bankRossii_descriptionShort">约 44 种汇率\n来源：俄罗斯中央银行</string>
    <string name="api_bankRossii_descriptionUpdateInterval">汇率每日更新，<a href="https://cbr.ru/eng/other/holidays/">俄罗斯公共假日</a>除外。</string>
    <string name="api_ferEe_descriptionFull"><a href="https://fer.ee/"><b>Fer.ee</b></a> 是一项较新的服务，与 Frankfurter.app 一样，追踪欧洲中央银行公布的参考汇率（外汇）。\n<b>包括约 30 种货币。</b></string>
    <string name="api_ferEe_descriptionUpdateInterval">数据会在工作日更新。</string>
    <string name="api_frankfurterApp_descriptionFull"><a href="https://www.frankfurter.app/"><b>Frankfurter.app</b></a> 跟踪欧洲中央银行公布的参考汇率（外汇）。\n<b>包括约 30 种货币。</b></string>
    <string name="api_frankfurterApp_descriptionShort">约 30 种汇率\n来源：欧洲中央银行</string>
    <string name="api_frankfurterApp_descriptionUpdateInterval">数据于每个工作日欧洲中部时间 16:00 左右更新。</string>
    <string name="api_inforEuro_descriptionFull"><a href="https://commission.europa.eu/funding-tenders/procedures-guidelines-tenders/information-contractors-and-beneficiaries/exchange-rate-inforeuro_en"><b>InforEuro</b></a>提供欧盟委员会的欧元官方月度核算汇率以及欧盟委员会会计主任根据《财务条例》第 19 条确定的换算率。\n这些汇率用于计算应欧盟委员会要求参加会议、采访等活动的外部人员的费用、差旅费或生活费报销金额。\n<b>包括约 150 种货币。</b></string>
    <string name="api_inforEuro_descriptionShort">约 150 种汇率\n来源：欧盟委员会</string>
    <string name="api_inforEuro_descriptionUpdateInterval">所示汇率为欧洲中央银行公布的上月倒数第二天的市场汇率，或视情况由代表团或其他适当来源在该日期前后提供的汇率。</string>
    <string name="api_inforEuro_hint">汇率每月仅更新一次！</string>
    <string name="api_norgesBank_descriptionFull">由挪威中央银行<a href="https://www.norges-bank.no/en/topics/Statistics/exchange_rates/"><b>挪威银行</b></a>提供的汇率。\n<b>挪威银行提供了约 40 种汇率。</b></string>
    <string name="api_norgesBank_descriptionShort">约 40 种汇率\n来源：挪威中央银行</string>
    <string name="api_norgesBank_descriptionUpdateInterval">汇率公布时间为每日的 16:00（欧洲中部时间）。</string>
    <string name="api_norgesBank_hint">该服务经常停机（HTTP 503），期间无法更新汇率！</string>
    <string name="api_openExchangeRates_descriptionFull">数据从多个可靠来源跟踪并整合，确保汇率客观公正。如需更多信息，请参阅 <a href="https://openexchangerates.org/"><b>openexchangerates.org</b></a>。\n<b>Open Exchange Rates 提供多达约 160 种汇率。\n<i>要使用此数据源，您必须输入您的个人 API 密钥！</i></b></string>
    <string name="api_openExchangeRates_descriptionShort">约 160 种汇率\n来源：多家可靠提供者的组合。</string>
