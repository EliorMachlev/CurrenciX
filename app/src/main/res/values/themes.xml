<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash-screen theme for MainActivity. Inherits Theme.SplashScreen from
    androidx.core:core-splashscreen so we get the API 31+ SplashScreen APIs
    on every supported release (minSdk 33).

    The splash shows the app's mark (brand_mark, the launcher icon's shape)
    on the app's own background, paper or ink (splashBackground), so the
    seam into the first Compose frame doesn't show. Its arrows keep turning
    around the ×, half a turn at a time, swapping places
    (brand_mark_animated). MainActivity holds the splash until Compose has
    drawn, then fades the mark out while the top bar's wordmark plays its
    reveal, and installs postSplashScreenTheme, the normal AppTheme, which MainActivity
    may further swap for AppTheme.PureBlack.

    MainActivity is the app's only Activity; every screen is a Compose
    destination inside it, so the launcher splash shows once per launch.
-->
<resources>
    <style name="AppTheme.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splashBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/brand_mark_animated</item>
        <!-- The app's version under the mark, generated at build time
             (GenerateSplashVersion in app/build.gradle.kts). The splash
             library has no attribute for it; Android has had one since
             API 31, below minSdk. -->
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_version</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
