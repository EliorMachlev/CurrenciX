<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Screen-to-screen (Activity) transition length. XML twin of the
         Compose motion tokens in view/compose/theme/Motion.kt: between
         MEDIUM (220) and LONG (400), since a whole screen travels further
         than an element. Faster than the platform default open animation. -->
    <integer name="screen_transition_ms">250</integer>
    <!-- The incoming screen's fade finishes early so its content is legible
         while the slide settles. -->
    <integer name="screen_transition_fade_ms">180</integer>
</resources>
