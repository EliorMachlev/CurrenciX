<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="colorDisplayOverlay" format="reference|color" />
    <attr name="colorBackground" format="reference|color" />

    <!-- themes to be applied -->
    <style name="AppTheme" parent="BaseAppTheme" />

    <style name="AppTheme.PureBlack" parent="BaseAppTheme.PureBlack" />

    <!-- Popups over other apps (text-selection "Convert currency"): no window
         of their own to show, just the Compose sheet and its scrim. -->
    <style name="AppTheme.Translucent" parent="AppTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- No ActionBar: every screen draws its own Compose top bar, and the
         window is edge to edge (MainActivity.enableEdgeToEdge). -->
    <style name="BaseAppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- theme-dependant colors (different for light/dark/black) -->
        <item name="colorBackground">@color/colorBackground</item>
        <item name="colorDisplayOverlay">@color/displayOverlay</item>

        <!-- Compose owns the visual palette (see view/compose/theme/Color.kt).
             The XML theme supplies the window background (painted behind
             every screen, pure black included), the chart colors the
             timeline resolves from it, and AppCompat widgets' defaults. -->

        <item name="android:colorBackground">?attr/colorBackground</item>
        <item name="colorPrimary">@color/billGreen</item>
        <item name="colorAccent">@color/brass</item>

        <!-- Keep theme-wide popupBackground transparent so the text-selection
             handle's PopupWindow doesn't render a white square behind the
             handle drawable. Menus are Compose DropdownMenus, which draw
             their own surface. -->
        <item name="android:popupBackground">@android:color/transparent</item>
    </style>

    <style name="BaseAppTheme.PureBlack" parent="AppTheme">
        <!-- colors -->
        <item name="colorBackground">@color/colorBackgroundPureBlack</item>
        <item name="colorDisplayOverlay">@color/displayOverlayPureBlack</item>
    </style>

    <!-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->

    <!-- style of the keypad buttons -->
</resources>
