    <!-- about -->
    <string name="category_about">About this app</string>
    <string name="disclaimer_title">Disclaimer</string>
    <string name="disclaimer_summary">Exchange rates shown are <b>indicative only</b>. They come from third-party providers, may be delayed or wrong, and <b>must not</b> be used for trading, hedging, invoicing, or any decision where an accurate or executable rate is required. See the Terms of Service for the full disclaimer.\nRates provided – even if correct – may differ from those used by your bank.\nLastly: mistakes happen. Never blindly trust any single source.\nThis app is fully free and open source. If you find a version with a price tag or ads, it is fake — uninstall it immediately.</string>
