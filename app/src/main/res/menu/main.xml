<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- Toolbar keeps the four highest-frequency shortcuts as always-visible
         action icons; every entry (including these) also lives in the
         hamburger drawer for discoverability. The overflow slot is intentionally
         empty — everything else routes through the drawer instead. -->
    <item
        android:orderInCategory="0"
        android:id="@+id/timeline"
        android:icon="@drawable/ic_timeline"
        android:title="@string/menu_timeline"
        app:showAsAction="always" />

    <item
        android:orderInCategory="1"
        android:id="@+id/cart"
        android:icon="@drawable/ic_cart"
        android:title="@string/cart_title"
        app:showAsAction="always" />

    <item
        android:orderInCategory="2"
        android:id="@+id/quick_conversions"
        android:icon="@drawable/ic_table"
        android:title="@string/menu_quick_conversions"
        app:showAsAction="always" />

    <item
        android:orderInCategory="3"
        android:id="@+id/date_picker"
        android:icon="@drawable/ic_history"
        android:title="@string/menu_historical_rates"
        app:showAsAction="always" />
</menu>
