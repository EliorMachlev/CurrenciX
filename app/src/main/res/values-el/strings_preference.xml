    <!-- about -->
    <string name="category_about">Σχετικά με την εφαρμογή</string>
    <string name="disclaimer_title">Αποποίηση ευθυνών</string>
    <string name="disclaimer_summary">Οι συναλλαγματικές ισοτιμίες που εμφανίζονται είναι <b>μόνο ενδεικτικές</b>. Προέρχονται από τρίτους παρόχους, ενδέχεται να είναι καθυστερημένες ή λανθασμένες και <b>δεν πρέπει</b> να χρησιμοποιούνται για συναλλαγές, αντιστάθμιση κινδύνου, τιμολόγηση ή οποιαδήποτε απόφαση όπου απαιτείται ακριβής ή εκτελέσιμη ισοτιμία. Δείτε τους Όρους Υπηρεσίας για την πλήρη αποποίηση ευθύνης.\nΟι παρεχόμενες ισοτιμίες – ακόμη κι αν είναι σωστές – ενδέχεται να διαφέρουν από αυτές που χρησιμοποιεί η τράπεζά σας.\nΤέλος: λάθη συμβαίνουν. Μην εμπιστεύεστε ποτέ τυφλά καμία μεμονωμένη πηγή.\nΑυτή η εφαρμογή είναι εντελώς δωρεάν και ανοιχτού κώδικα. Αν βρείτε μια έκδοση με τιμή ή διαφημίσεις, είναι ψεύτικη — απεγκαταστήστε την αμέσως.</string>
    <string name="rate_title">Αξιολόγηση της εφαρμογής</string>
