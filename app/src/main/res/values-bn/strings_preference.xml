    <string name="category_about">এই অ্যাপ সম্পর্কে</string>
    <string name="disclaimer_title">বিশেষ বিজ্ঞপ্তি</string>
    <string name="disclaimer_summary">প্রদর্শিত বিনিময় হার <b>শুধুমাত্র নির্দেশক</b>। এগুলো তৃতীয় পক্ষের সরবরাহকারী থেকে আসে, বিলম্বিত বা ভুল হতে পারে, এবং ট্রেডিং, হেজিং, চালান তৈরি, বা এমন কোনো সিদ্ধান্তের জন্য <b>ব্যবহার করা উচিত নয়</b> যেখানে সঠিক বা কার্যকর হারের প্রয়োজন। সম্পূর্ণ দায়বদ্ধতা অস্বীকৃতির জন্য পরিষেবার শর্তাবলী দেখো।\nপ্রদত্ত হারগুলো – সঠিক হলেও – তোমার ব্যাংকের ব্যবহৃত হার থেকে আলাদা হতে পারে।\nশেষে: ভুল হয়। কখনোই অন্ধভাবে কোনো একক উৎসের ওপর বিশ্বাস করবে না।\nএই অ্যাপটি সম্পূর্ণ বিনামূল্যে এবং ওপেন সোর্স। যদি এমন কোনো সংস্করণ পাও যেখানে মূল্য বা বিজ্ঞাপন আছে, সেটি নকল — অবিলম্বে আনইনস্টল করো।</string>
