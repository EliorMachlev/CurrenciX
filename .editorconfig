root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
# Compose composable functions are PascalCase by convention — exempt them
# from the standard function-naming rule instead of littering every composable
# with a suppression annotation.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{yml,yaml,md,json}]
indent_size = 2
