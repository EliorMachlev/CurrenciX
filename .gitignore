# Android Studio captures folder
captures/

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild

# Google Services (e.g. APIs or Firebase)
google-services.json

# Gradle files
.gradle/
build/

# Kotlin compiler session files
.kotlin/

# Local artifacts (downloaded CI screenshot dumps, etc.)
artifacts/

# Claude Code local state (agent worktrees, etc.)
.claude/worktrees/

# IntelliJ
*.iml
.idea/

# keystore/api keys/local configuration (app/debug.keystore is shared on purpose)
*.jks
*.p12
/signing/
keystore.properties
secrets.properties
local.properties

#OS
._*
.DS_Store
Thumbs.db

# npx skills tool leftover
skills-lock.json

# scratch design/proposal drops that aren't ready to commit
art/logo-proposals/
art/theme-proposals/

# Python bytecode from the .github/scripts helpers
__pycache__/

# Jazzer's working corpus from local fuzzing runs (regenerated every run)
.cifuzz-corpus/

# OWASP Dependency-Check vulnerability data (CI cache)
/.dependency-check-data/
